NODE_ENV=development
PORT=3000
# In produzione: https://facile.webcloud.it (più origini separate da virgola).
CORS_ORIGIN=*

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=45000
OLLAMA_ROUTER_TIMEOUT_MS=15000
# Qwen3: false riduce latenza e consumo per routing e risposte operative.
OLLAMA_THINK=false
# Mantiene il modello caricato tra richieste consecutive.
OLLAMA_KEEP_ALIVE=10m
# Impostare true in produzione: /ready risponderà 503 se Ollama o il modello non sono disponibili.
OLLAMA_REQUIRED=false

# Validazione del token CRM dell'utente Facile.
AUTH_VALIDATION_TIMEOUT_MS=5000
AUTH_CACHE_TTL_MS=60000
# Consigliato in produzione: UUID dei ruoli Directus Facile autorizzati, separati da virgola.
AI_ALLOWED_CRM_ROLE_IDS=

CRM_DIRECTUS_BASE_URL=https://crm.webcloud.cloud
CRM_TOKEN=
CRM_FETCH_TIMEOUT_MS=10000

RENEWALS_SERVICES_CACHE_TTL_MS=300000
RENEWALS_SETTINGS_CACHE_TTL_MS=300000
RENEWALS_API_BASE_URL=https://crm-renewals-api.webcloud.cloud

FACILE_INTEGRATIONS_API_BASE_URL=https://crm-integrations-api.webcloud.cloud/
ACCESS_TOKEN=

WEBCAMGO_DIRECTUS_BASE_URL=https://webcamgo-cloud-cms.webcloud.cloud
WEBCAMGO_FETCH_TIMEOUT_MS=15000
WEBCAMGO_CONTROL_API_BASE_URL=https://global-webcamgo-control-api.lhepmt.easypanel.host
WEBCAMGO_CONTROL_API_KEY=

# Send in Italy / SpecialK. In locale SpecialK gira su 3001 per non collidere con questa API.
